<ContentDialog
    x:Class="Localcel_WinUI3.Dialogs.DependencyInstallerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Installing Dependency"
    CloseButtonStyle="{StaticResource DialogDefaultButtonStyle}"
    CornerRadius="8">

    <Grid Width="460" Height="300" RowDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0">
        <TextBlock x:Name="TxtStatus" Grid.Row="0" Text="Preparing installation via Winget..." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

        <ProgressBar x:Name="ProgressInstall" Grid.Row="1" IsIndeterminate="True" Height="4" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

        <Grid Grid.Row="2" Background="#28000000" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox
                    x:Name="TxtLogOutput"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas, Cascadia Code, Courier New"
                    FontSize="12"
                    Foreground="#E5E5E5"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="10"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"/>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="TxtError" Grid.Row="3" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</ContentDialog>
