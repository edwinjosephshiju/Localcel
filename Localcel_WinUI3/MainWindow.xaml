<Window
    x:Class="Localcel_WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:models="using:Localcel_WinUI3.Models"
    mc:Ignorable="d"
    Title="Localcel - Vercel for Localhost">

    <Grid>
        <!-- System Tray Icon -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="ms-appx:///Assets/localcel_logo.ico"
            ToolTipText="Localcel - No running servers">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout x:Name="TrayMenuFlyout">
                    <!-- Dynamic running apps inserted programmatically -->
                    <MenuFlyoutItem Text="Show Localcel" Click="TrayShow_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Exit" Click="TrayExit_Click"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <Grid RowDefinitions="Auto,*">
            <!-- Custom Title Bar extending Mica into titlebar region -->
            <Grid x:Name="AppTitleBar" Grid.Row="0" Height="38" Background="Transparent" Padding="16,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/localcel_logo.ico" Width="18" Height="18"/>
                    <TextBlock Text="Localcel - Vercel for Localhost" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Main Window Layout -->
            <Grid Grid.Row="1" ColumnDefinitions="280,*">
                <!-- Left Sidebar with semi-transparent backdrop layer -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Padding="16,12,16,16" Background="#2B000000" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <!-- App Title Header -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="4,0,4,16">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/localcel_logo.ico" Width="28" Height="28"/>
                        <TextBlock Text="Localcel" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="Vercel for Localhost" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- App List -->
                <ListView
                    x:Name="AppListView"
                    Grid.Row="1"
                    SelectionChanged="AppListView_SelectionChanged"
                    SelectionMode="Single"
                    Margin="0,0,0,12"
                    Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AppItemViewModel">
                            <Grid ColumnDefinitions="*,Auto" Padding="4,8">
                                <TextBlock Text="{x:Bind DisplayTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Ellipse Grid.Column="1" Width="10" Height="10" Margin="8,0,0,0" VerticalAlignment="Center" Fill="{x:Bind StatusBrush, Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Sidebar Actions -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <Button x:Name="BtnNewApp" Content="New App" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="BtnNewApp_Click"/>
                    <Grid ColumnDefinitions="*,*">
                        <Button x:Name="BtnCfLogin" Content="CF Login" Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch" Click="BtnCfLogin_Click"/>
                        <Button x:Name="BtnGitLogin" Content="Git Login" Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Stretch" Click="BtnGitLogin_Click"/>
                    </Grid>
                    <Button x:Name="BtnTunnelManager" Content="Tunnel Manager" HorizontalAlignment="Stretch" Click="BtnTunnelManager_Click"/>
                </StackPanel>
            </Grid>

            <!-- Right Content Area -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Padding="24" Background="Transparent">
                <!-- Translucent Header Card -->
                <Border Grid.Row="0" Background="#35252525" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="TxtAppTitle" Text="Select an application" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                        <StackPanel x:Name="PanelUrlContainer" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <HyperlinkButton x:Name="BtnLocalUrl" Content="Local: http://localhost" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtSeparator" Text="|" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <HyperlinkButton x:Name="BtnPublicUrl" Content="Tunnel: https://..." Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtAppStatus" Text="Not running" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Control Bar -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,16,0,16">
                    <Button x:Name="BtnStart" Content="Start" Grid.Column="0" Margin="0,0,8,0" Click="BtnStart_Click" Style="{StaticResource AccentButtonStyle}"/>
                    <Button x:Name="BtnStop" Content="Stop" Grid.Column="1" Margin="0,0,8,0" Click="BtnStop_Click" IsEnabled="False"/>
                    <Button x:Name="BtnDeploy" Content="Deploy" Grid.Column="2" Margin="0,0,8,0" Click="BtnDeploy_Click" Visibility="Collapsed"/>
                    <Button x:Name="BtnEdit" Content="Edit App" Grid.Column="3" Margin="0,0,8,0" Click="BtnEdit_Click"/>

                    <Button x:Name="BtnDelete" Content="Delete App" Grid.Column="5" Click="BtnDelete_Click"/>
                </Grid>

                <!-- Log Output TabView with full-height Terminal Viewers -->
                <TabView Grid.Row="2" IsAddTabButtonVisible="False" CanReorderTabs="False" Background="Transparent" VerticalAlignment="Stretch">
                    <TabViewItem Header="Server Logs" IsClosable="False">
                        <Grid Background="#28000000" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Margin="0,4,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox
                                    x:Name="TxtServerLogs"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    FontFamily="Consolas, Cascadia Code, Courier New"
                                    FontSize="13"
                                    Foreground="#E5E5E5"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch"/>
                            </ScrollViewer>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem Header="Tunnel/Deploy Logs" IsClosable="False">
                        <Grid Background="#28000000" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Margin="0,4,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox
                                    x:Name="TxtTunnelLogs"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    FontFamily="Consolas, Cascadia Code, Courier New"
                                    FontSize="13"
                                    Foreground="#E5E5E5"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch"/>
                            </ScrollViewer>
                        </Grid>
                    </TabViewItem>
                </TabView>
            </Grid>
        </Grid>
    </Grid>
</Grid>
</Window>
