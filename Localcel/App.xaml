<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Localcel.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Localcel">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Stock WinUI 3 Fluent Corner Radius Tokens -->
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ContentDialogCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ContentDialogButtonCornerRadius">4</CornerRadius>

            <!-- Explicit Button Styles for ContentDialogs -->
            <Style x:Key="DialogDefaultButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="4"/>
            </Style>

            <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="4"/>
            </Style>

            <!-- Implicit Control Styles -->
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="4"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="4"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="4"/>
            </Style>

            <!-- WinUI 3 ContentDialog Style -->
            <Style TargetType="ContentDialog">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="PrimaryButtonStyle" Value="{StaticResource DialogPrimaryButtonStyle}"/>
                <Setter Property="SecondaryButtonStyle" Value="{StaticResource DialogDefaultButtonStyle}"/>
                <Setter Property="CloseButtonStyle" Value="{StaticResource DialogDefaultButtonStyle}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
