<ContentDialog
    x:Class="Localcel.Dialogs.TunnelManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Localcel.Services"
    mc:Ignorable="d"
    Title="Cloudflare Tunnels"
    CloseButtonText="Close"
    CloseButtonStyle="{StaticResource DialogDefaultButtonStyle}"
    CornerRadius="8">

    <Grid Width="460" Height="360" RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">
        <TextBlock x:Name="TxtInfo" Text="Active Tunnels" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PanelTunnels" Spacing="8">
                <!-- Dynamically populated or items template -->
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="BtnRefresh" Content="Refresh Status" CornerRadius="4" Click="BtnRefresh_Click"/>
        </StackPanel>
    </Grid>
</ContentDialog>
